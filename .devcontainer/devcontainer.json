#!/bin/bash

# 📁 Cílové složky
INSTALL_DIR="$HOME/medinria-install"
BUILD_DIR="$HOME/medinria-build"
SRC_DIR="$HOME/medinria-superproject"

# 🔄 Vyčisti staré složky (volitelné)
rm -rf "$BUILD_DIR" "$INSTALL_DIR"

# 🧩 Klonuj superbuild repozitář
git clone https://github.com/medInria/medinria-superproject.git "$SRC_DIR"

# 📦 Vytvoř build adresář
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

# ⚙️ Spusť konfiguraci CMake s vlastním prefixem
cmake "$SRC_DIR" \
  -DCMAKE_INSTALL_PREFIX="$INSTALL_DIR" \
  -DCMAKE_BUILD_TYPE=Release \
  -DBUILD_TESTING=OFF

# 🛠️ Přelož projekt
make -j$(nproc)

# 📥 Nainstaluj do zadané složky
make install

# ✅ Hotovo
echo ""
echo "✅ medInria byl úspěšně nainstalován do: $INSTALL_DIR"
echo "👉 Nezapomeň přidat knihovny do LD_LIBRARY_PATH:"
echo "export LD_LIBRARY_PATH=$INSTALL_DIR/lib:\$LD_LIBRARY_PATH"
